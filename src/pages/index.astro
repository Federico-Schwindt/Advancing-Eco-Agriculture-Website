---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { url, featured, crops, testimonials, growerLogos, pyramid, products, catalog } from '../lib/site';

const m = (p: string) => url(`/media/${p}`);
const bySlug = (s: string) => products.find((p) => p.slug === s);
const cropImgs: Record<string, string> = Object.fromEntries(crops.map((c) => [c.slug, url(`/img/aea/crop-${c.slug}.avif`)]));
---
<Base
  navTone="light"
  preload={[
    { href: m('hero-1600.avif'), as: 'image', type: 'image/avif', media: '(min-width: 701px)' },
    { href: m('hero-540v.avif'), as: 'image', type: 'image/avif', media: '(max-width: 700px)' },
  ]}
>
  <!-- ============================== HERO ============================== -->
  <section class="hero theme-dark" data-hero>
    <div class="hero__media grain" data-hero-media>
      <picture>
        <source media="(max-width: 700px)" srcset={m('hero-540v.avif')} type="image/avif" />
        <img class="hero__poster" src={m('hero-1600.avif')} alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
      </picture>
      <video class="hero__video" muted loop playsinline preload="none" aria-hidden="true" data-hero-video data-wide={m('hero-960.mp4')} data-narrow={m('hero-432v.mp4')}></video>
      <div class="hero__shade"></div>
    </div>

    <div class="hero__content wrap" data-hero-content>
      <p class="eyebrow hero__eyebrow" data-reveal="fade">Regenerative agriculture · Since 2006</p>
      <h1 class="display-hero hero__title" data-split>Healthy plants <em class="serif">defend</em> themselves.</h1>
      <div class="hero__row">
        <p class="hero__lead" data-reveal style="--d:500">Plant-sap science, biological nutrition and agronomists in the field — helping growers raise crops that resist pests and disease, with fewer inputs and better returns.</p>
        <div class="hero__ctas" data-reveal style="--d:650">
          <a class="btn btn--sun" href={url('/shop/')}>Shop products <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--glass" href={url('/contact/')}>Talk to an agronomist</a>
        </div>
      </div>
    </div>

    <div class="hero__bar wrap" data-reveal="fade" style="--d:900">
      <dl class="hero__stats">
        <div><dt>Acres under program</dt><dd class="tnum"><span data-count="4">4</span>M+</dd></div>
        <div><dt>Farms supported</dt><dd class="tnum"><span data-count="10000" data-format="comma">10,000</span>+</dd></div>
        <div><dt>Years of sap data</dt><dd class="tnum"><span data-count="19">19</span></dd></div>
        <div><dt>Vision for 2040</dt><dd class="tnum"><span data-count="80">80</span>%</dd></div>
      </dl>
      <a href="#dig" class="hero__scroll" aria-label="Scroll to explore">
        <span class="mono">Scroll to dig in</span>
        <span class="hero__scroll-dot"><Icon name="arrow-down" /></span>
      </a>
    </div>
  </section>

  <!-- ============================== MANIFESTO ============================== -->
  <section class="manifesto theme-bone section" id="dig">
    <div class="wrap">
      <p class="eyebrow">Our story in one breath</p>
      <p class="manifesto__text" data-scrub-words>
        It began in <span class="pill-img"><img src={url('/img/aea/story-cantaloupe-480.avif')} alt="" width="120" height="60" loading="lazy" /></span> a melon patch on an Amish farm in Ohio — two fields, two feet apart. One sick, one <em class="serif">thriving.</em> Today we help ten thousand farms across four million acres grow crops so <span class="pill-img"><img src={url('/media/roots-800.avif')} alt="" width="120" height="60" loading="lazy" /></span> healthy that pests simply pass them by.
      </p>
      <div class="manifesto__foot">
        <a class="btn btn--ghost" href={url('/about/')}>Read our story <Icon name="arrow" class="arrow" /></a>
        <p class="mono muted">— John Kempf, founder</p>
      </div>
    </div>
  </section>

  <!-- ============================== DESCENT (scroll-scrubbed) ============================== -->
  <section class="descent theme-dark" data-descent aria-label="Journey below the soil surface">
    <div class="descent__pin" data-descent-pin>
      <div class="descent__media">
        <picture>
          <source media="(max-width: 700px)" srcset={m('descent-poster-486v.avif')} type="image/avif" />
          <img class="descent__poster" src={m('descent-poster-1024.avif')} alt="" width="1024" height="576" loading="lazy" decoding="async" />
        </picture>
        <video class="descent__video" muted playsinline preload="none" aria-hidden="true" data-descent-video data-wide={m('descent-1024.mp4')} data-narrow={m('descent-486v.mp4')}></video>
        <div class="descent__shade"></div>
      </div>

      <div class="descent__depth" aria-hidden="true">
        <span class="mono">Depth</span>
        <div class="descent__ruler"><i data-depth-marker></i></div>
        <span class="mono tnum"><b data-depth>+00</b> cm</span>
      </div>

      <div class="descent__chapters wrap">
        <article class="chapter is-active" data-chapter>
          <p class="eyebrow">Above ground</p>
          <h2 class="h1">What you see is only <em class="serif">half</em> the farm.</h2>
        </article>
        <article class="chapter" data-chapter>
          <p class="chapter__n mono">01 / Exudates</p>
          <h2 class="h2">Healthy plants feed the soil.</h2>
          <p class="lead">Plants send much of the sugar they make through photosynthesis down into the soil as root exudates — fuel for the microbial life below.</p>
        </article>
        <article class="chapter" data-chapter>
          <p class="chapter__n mono">02 / Biology</p>
          <h2 class="h2">Microbes are the plant’s digestive system.</h2>
          <p class="lead">Soil biology releases minerals in bioavailable forms that plants absorb far more efficiently than the simple ions in conventional fertilizer.</p>
        </article>
        <article class="chapter" data-chapter>
          <p class="chapter__n mono">03 / Networks</p>
          <h2 class="h2">Fungal networks extend every root.</h2>
          <p class="lead">Mycorrhizal hyphae reach far beyond the root zone, trading water and minerals for carbon — and building soil structure as they go.</p>
        </article>
        <article class="chapter" data-chapter>
          <p class="eyebrow">Below ground</p>
          <h2 class="h1">This is where <em class="serif">yield</em> begins.</h2>
          <a class="btn btn--sun" href={url('/shop/?c=Soil%20Priming')} style="margin-top:28px">Explore soil priming <Icon name="arrow" class="arrow" /></a>
        </article>
      </div>

      <div class="descent__progress" aria-hidden="true"><i data-descent-progress></i></div>
    </div>
  </section>

  <!-- ============================== PLANT HEALTH PYRAMID ============================== -->
  <section class="php section theme-dark" data-php>
    <div class="wrap">
      <div class="php__head">
        <p class="eyebrow">The Plant Health Pyramid</p>
        <h2 class="h1" data-split>Immunity is built in <em class="serif">four</em> levels.</h2>
        <p class="lead">Created by John Kempf, the pyramid maps a plant’s journey to complete immunity. Each level is a physiological process — and each unlocks resistance to a new group of pests and diseases.</p>
      </div>

      <div class="php__grid">
        <div class="php__visual" aria-hidden="true">
          <div class="php__sticky">
            <svg viewBox="0 0 400 360" class="php__svg">
              <defs>
                <linearGradient id="phpSun" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#ffc95e" />
                  <stop offset="1" stop-color="#f9b134" />
                </linearGradient>
              </defs>
              {[4, 3, 2, 1].map((lv) => {
                const i = 4 - lv; // 0 top
                const h = 78, gap = 8;
                const y = 20 + i * (h + gap);
                const topW = 40 + i * 86, botW = 40 + (i + 1) * 86;
                const cx = 200;
                const pts = `${cx - topW / 2},${y} ${cx + topW / 2},${y} ${cx + botW / 2},${y + h} ${cx - botW / 2},${y + h}`;
                return (
                  <g class="php__lv" data-php-lv={lv}>
                    <polygon points={pts} />
                    <text x={cx} y={y + h / 2 + 5} text-anchor="middle">{`0${lv}`}</text>
                  </g>
                );
              })}
            </svg>
            <ul class="php__legend">
              {pyramid.slice().reverse().map((l) => (
                <li data-php-legend={l.level}><span class="mono">0{l.level}</span>{l.short}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="php__levels">
          {pyramid.map((l) => (
            <article class="lvl" data-php-level={l.level}>
              <div class="lvl__top">
                <span class="lvl__n mono">Level 0{l.level}</span>
                <span class="chip">Resists · {l.resists}</span>
              </div>
              <h3 class="h2">{l.title}</h3>
              <p class="lead">{l.process}</p>
              <div class="lvl__cols">
                <div>
                  <p class="mono muted">Builds resistance to</p>
                  <ul class="lvl__pests">{l.pests.map((p) => <li>{p}</li>)}</ul>
                </div>
                <div>
                  <p class="mono muted">{l.needs[0].n ? 'Minerals required' : 'Driven by'}</p>
                  <div class="elements">
                    {l.needs.map((e) => (
                      <div class:list={['el', { 'el--wide': !e.n }]} title={e.name}>
                        {e.n > 0 && <span class="el__n">{e.n}</span>}
                        <b>{e.sym}</b>
                        <span class="el__name">{e.name}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
              <div class="lvl__products">
                <span class="mono muted">Products for this level</span>
                {l.products.map((s) => {
                  const p = bySlug(s);
                  return p && (
                    <a class="lvl__prod" href={url(`/shop/${p.slug}/`)}>
                      <img src={url(`/img/products/${p.image}-320.webp`)} alt="" width="40" height="40" loading="lazy" />
                      {p.name}
                    </a>
                  );
                })}
              </div>
            </article>
          ))}
          <a class="btn btn--ghost" href={url('/science/')}>Go deeper into the science <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== PRODUCTS RAIL ============================== -->
  <section class="rail theme-bone" data-rail>
    <div class="rail__pin" data-rail-pin>
      <div class="wrap rail__head">
        <div>
          <p class="eyebrow">The toolkit</p>
          <h2 class="h2" data-split>Nutrition that <em class="serif">works with</em> biology.</h2>
        </div>
        <div class="rail__meta">
          <p class="muted">{catalog.length} naturally-derived products, made in the USA. Many OMRI listed for organic production.</p>
          <a class="btn" href={url('/shop/')}>Shop all products <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
      <div class="rail__viewport" data-rail-viewport>
        <div class="rail__track" data-rail-track>
          {featured.map((p, i) => <ProductCard p={p} class="rail__card" />)}
          <a class="rail__more" href={url('/shop/')}>
            <span class="h3">See all<br />{catalog.length} products</span>
            <span class="rail__more-arrow"><Icon name="arrow-up-right" /></span>
          </a>
        </div>
      </div>
      <div class="wrap rail__progress-wrap" aria-hidden="true"><div class="rail__progress"><i data-rail-progress></i></div></div>
    </div>
  </section>

  <!-- ============================== SOLUTIONS BENTO ============================== -->
  <section class="solutions section theme-moss">
    <div class="wrap">
      <div class="sol__head">
        <p class="eyebrow">A whole-systems approach</p>
        <h2 class="h1" data-split>Products are only <em class="serif">part</em> of it.</h2>
      </div>
      <div class="bento">
        <article class="tile tile--consult" data-reveal>
          <div class="tile__media"><img src={url('/img/aea/story-agronomist.avif')} alt="AEA agronomist in the field" width="862" height="829" loading="lazy" decoding="async" /></div>
          <div class="tile__body">
            <span class="tile__icon"><Icon name="people" /></span>
            <h3 class="h3">Agronomic consulting</h3>
            <p>Regional Farm Services teams with deep expertise across crop types. Complimentary with qualifying product programs — or Groundwork contract consulting, no purchase necessary.</p>
            <a class="link-u" href={url('/contact/')}>Meet your agronomist →</a>
          </div>
        </article>
        <article class="tile tile--sap" data-reveal style="--d:100">
          <video muted loop playsinline preload="none" aria-hidden="true" data-lazy-video poster={m('leaf-960.avif')}>
            <source data-src={m('leaf-960.mp4')} type="video/mp4" />
          </video>
          <div class="tile__body">
            <span class="tile__icon"><Icon name="drop" /></span>
            <p class="tile__big tnum">23</p>
            <h3 class="h3">data points in every sap test</h3>
            <p>A blood test for crops. Plant sap analysis reveals deficiencies weeks before symptoms show in the field.</p>
            <a class="link-u" href={url('/science/#sap')}>How sap analysis works →</a>
          </div>
        </article>
        <article class="tile tile--nutrition" data-reveal style="--d:200">
          <div class="tile__media"><img src={m('hands-720.avif')} alt="" width="720" height="900" loading="lazy" decoding="async" /></div>
          <div class="tile__body">
            <span class="tile__icon"><Icon name="leaf" /></span>
            <h3 class="h3">Regenerative plant nutrition</h3>
            <p>Microorganisms, plant extracts and humic substances — sourced in North America, manufactured in Ohio and Colorado.</p>
          </div>
        </article>
        <article class="tile tile--edu" data-reveal style="--d:300">
          <div class="tile__body">
            <span class="tile__icon"><Icon name="play" /></span>
            <h3 class="h3">The Regenerative Agriculture Podcast</h3>
            <p>John Kempf in conversation with farmers, scientists and agronomists shaping the future of food.</p>
            <div class="wave" aria-hidden="true">{Array.from({ length: 36 }).map((_, i) => <i style={`--h:${20 + Math.round(Math.abs(Math.sin(i * 1.7)) * 80)}%;--i:${i}`}></i>)}</div>
          </div>
        </article>
        <article class="tile tile--stat" data-reveal style="--d:150">
          <p class="tile__big tnum"><span data-count="17">17</span>+</p>
          <p>years of on-farm experience guiding every recommendation we make.</p>
        </article>
        <article class="tile tile--lab" data-reveal style="--d:250">
          <div class="tile__media"><img src={url('/img/aea/story-tubes.avif')} alt="AEA laboratory" width="862" height="829" loading="lazy" decoding="async" /></div>
          <div class="tile__body">
            <span class="tile__icon"><Icon name="flask" /></span>
            <h3 class="h3">Research & field trials</h3>
            <p>A lab in Middlefield, Ohio and on-farm trials across a broad range of crops. We don’t guess — we test.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================== CROPS ============================== -->
  <section class="cropsec section">
    <div class="wrap">
      <div class="cropsec__head">
        <div>
          <p class="eyebrow">Crop programs</p>
          <h2 class="h1" data-split>Built for <em class="serif">every</em> crop.</h2>
        </div>
        <p class="lead">From orchards to row crops to the backyard market garden — protocols tuned with sap data and two decades in the field.</p>
      </div>
      <div class="accordion-cards" data-reveal>
        {crops.map((c, i) => (
          <a class:list={['acard', { 'is-open': i === 0 }]} href={url(`/crops/${c.slug}/`)} data-acard>
            <img src={cropImgs[c.slug]} alt="" width="862" height="829" loading="lazy" decoding="async" />
            <div class="acard__shade"></div>
            <span class="acard__n mono">0{i + 1}</span>
            <span class="acard__vert">{c.name}</span>
            <div class="acard__body">
              <h3 class="h2">{c.name}</h3>
              <p>{c.subcrops.join(' · ')}</p>
              <span class="acard__go"><Icon name="arrow-up-right" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== TESTIMONIALS ============================== -->
  <section class="voices section theme-dark" data-voices>
    <div class="wrap">
      <div class="voices__head">
        <p class="eyebrow">Grower voices</p>
        <p class="mono muted"><span class="tnum" data-voice-index>01</span> / 0{testimonials.length}</p>
      </div>
      <div class="voices__stage">
        {testimonials.map((t, i) => (
          <figure class:list={['voice', { 'is-active': i === 0 }]} data-voice>
            <div class="voice__img"><img src={url(`/img/aea/${t.img}.avif`)} alt={t.name} width="640" height="800" loading="lazy" decoding="async" /></div>
            <blockquote class="voice__quote">“{t.quote}”</blockquote>
            <figcaption><b>{t.name}</b><span class="muted">{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="voices__nav" role="tablist" aria-label="Testimonials">
        {testimonials.map((t, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-voice-tab={i}>
            <span class="voices__bar"><i></i></span>
            <span class="voices__name">{t.name}</span>
            <span class="voices__role mono">{t.role.split('·')[0]}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="logos" aria-label="Some of the farms we work with">
      <div class="marquee" style="--mdur:55s;--mgap:64px">
        {[0, 1].map((k) => (
          <div class="marquee__track" aria-hidden={k === 1 ? 'true' : undefined}>
            {growerLogos.map((l) => <img src={url(`/img/logos/${l}.webp`)} alt={k === 0 ? l.replace(/-/g, ' ') : ''} width="110" height="110" loading="lazy" />)}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== PROCESS ============================== -->
  <section class="process section theme-bone">
    <div class="wrap">
      <div class="process__head">
        <p class="eyebrow">How we work together</p>
        <h2 class="h1" data-split>From first call to <em class="serif">harvest.</em></h2>
      </div>
      <ol class="steps">
        {[
          ['Start a conversation', 'Tell us about your operation, goals and the limiting factors you’re facing.'],
          ['Holistic assessment', 'An AEA agronomist evaluates your whole system — soil, crop, practices and budget.'],
          ['Collect the right data', 'We set up sap and soil sampling at the moments that matter most.'],
          ['Protocols that fit', 'Receive a unique crop plan matched to your goals, with support all season.'],
          ['Review & refine', 'Seasonal review and planning so every year builds on the last.'],
        ].map(([t, d], i) => (
          <li class="step" data-reveal style={`--d:${i * 90}`}>
            <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t}</h3>
            <p class="muted">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================== VISION ============================== -->
  <section class="vision theme-dark" data-vision>
    <div class="vision__bg"><img src={m('roots-1344.avif')} alt="" width="1344" height="752" loading="lazy" decoding="async" data-vision-img /></div>
    <div class="wrap vision__inner">
      <p class="eyebrow">Our vision</p>
      <p class="vision__num tnum"><span data-count="80">80</span><span class="serif">%</span></p>
      <h2 class="h2 vision__line">of global agriculture regenerative by <em class="serif">2040.</em></h2>
      <p class="lead">Our mission: empower farmers with innovative, science-backed tools to regenerate and revitalize agriculture and food systems.</p>
    </div>
  </section>

  <!-- ============================== CTA ============================== -->
  <section class="cta">
    <div class="wrap cta__inner">
      <h2 class="cta__title" data-split>Let’s grow something <em class="serif">extraordinary.</em></h2>
      <div class="cta__row">
        <p>Whether you farm 5 acres or 50,000 — our agronomists will help you build a plan for healthier crops and stronger margins.</p>
        <div class="cta__btns">
          <a class="btn" href={url('/contact/')} style="--b-hover:var(--paper)">Talk to an agronomist <Icon name="arrow" class="arrow" /></a>
          <a class="btn btn--ghost" href={url('/shop/')} style="--line:rgba(13,12,9,.3)">Shop products</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/home';
  </script>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; isolation: isolate; }
  .hero__media { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero__poster, .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__video { opacity: 0; transition: opacity 1.2s ease; }
  .hero__video.is-ready { opacity: 1; }
  .hero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(13, 12, 9, 0.55) 0%, rgba(13, 12, 9, 0) 28%),
      linear-gradient(0deg, rgba(13, 12, 9, 0.92) 0%, rgba(13, 12, 9, 0.35) 42%, rgba(13, 12, 9, 0) 70%),
      radial-gradient(80% 60% at 0% 100%, rgba(13, 12, 9, 0.55), transparent);
  }
  .hero__content { position: relative; padding-top: calc(var(--nav-h) + 40px); }
  .hero__eyebrow { color: rgba(255, 255, 255, 0.8); }
  .hero__title { margin-top: 22px; color: #fff; max-width: 11ch; }
  .hero__title em { color: var(--sun); padding-right: 0.06em; }
  .hero__row { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-top: clamp(28px, 4vw, 48px); flex-wrap: wrap; }
  .hero__lead { max-width: 44ch; color: rgba(255, 255, 255, 0.78); font-size: var(--fs-lg); line-height: 1.45; }
  .hero__ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero__bar { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding-top: clamp(32px, 5vw, 64px); padding-bottom: 28px; }
  .hero__stats { display: grid; grid-template-columns: repeat(4, auto); gap: clamp(20px, 4vw, 64px); border-top: 1px solid rgba(255, 255, 255, 0.18); padding-top: 18px; flex: 1; }
  .hero__stats dt { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  .hero__stats dd { font-size: clamp(1.4rem, 1rem + 1.4vw, 2.3rem); font-weight: 500; letter-spacing: -0.04em; color: #fff; margin-top: 4px; }
  .hero__scroll { display: flex; align-items: center; gap: 12px; color: rgba(255, 255, 255, 0.75); }
  .hero__scroll-dot { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3); animation: bob 2.4s var(--ease-in-out) infinite; }
  .hero__scroll-dot :global(svg) { width: 18px; height: 18px; }
  @keyframes bob { 50% { transform: translateY(6px); } }
  @media (max-width: 860px) {
    .hero__stats { grid-template-columns: repeat(2, 1fr); row-gap: 16px; }
    .hero__scroll { display: none; }
  }

  /* ---------- MANIFESTO ---------- */
