---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { crops, products, cropProducts, url, type Crop } from '../../lib/site';

export function getStaticPaths() {
  return crops.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Crop };
const recs = (cropProducts[c.slug] || []).map((s) => products.find((p) => p.slug === s)).filter(Boolean) as typeof products;
const idx = crops.findIndex((x) => x.slug === c.slug);
const next = crops[(idx + 1) % crops.length];
const story = c.stories[0];
---
<Base title={`${c.name} program`} description={c.intro} navTone="light">
  <section class="chero theme-dark">
    <div class="chero__bg"><img src={url(`/img/aea/crop-${c.slug}-wide.avif`)} alt="" width="1600" height="1000" fetchpriority="high" /></div>
    <div class="wrap chero__inner">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={url('/')}>Home</a><span>/</span><a href={url('/crops/')}>Crops</a><span>/</span><span>{c.name}</span></nav>
      <h1 class="display-hero" data-split>{c.name}</h1>
      <div class="chero__row">
        <p class="lead" data-reveal style="--d:300">{c.intro}</p>
        <ul class="chero__subs" data-reveal style="--d:450">{c.subcrops.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section wrap cbody">
    <div class="cbody__lead">
      <p class="eyebrow">Our approach</p>
      <h2 class="h2" data-split>{c.statement}</h2>
    </div>
    <div class="cbody__text prose">
      {c.body.map((b) => <p>{b}</p>)}
    </div>
    <blockquote class="cbody__hl" data-reveal>
      <Icon name="sprout" size={28} />
      <p>{c.highlight}</p>
    </blockquote>
  </section>

  {c.faqs.length > 0 && (
    <section class="section--tight theme-bone">
      <div class="wrap cfaq">
        <div>
          <p class="eyebrow">Common questions</p>
          <h2 class="h2" style="margin-top:18px">What growers ask us about <em class="serif">{c.name.toLowerCase()}</em></h2>
        </div>
        <div class="acc">
          {c.faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<i aria-hidden="true"></i></summary>
              <div class="acc__body prose"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {story && (
    <section class="section theme-dark cstory">
      <div class="wrap">
        <p class="eyebrow">From the field</p>
        <p class="cstory__q" data-reveal>{story}</p>
      </div>
    </section>
  )}

  {recs.length > 0 && (
    <section class="section--tight wrap">
      <div class="rel__head">
        <div>
          <p class="eyebrow">Often in {c.name.toLowerCase()} programs</p>
          <h2 class="h2" style="margin-top:16px">Recommended <em class="serif">starting</em> points</h2>
        </div>
        <a class="btn btn--ghost btn--sm" href={url('/contact/')}>Get a custom protocol <Icon name="arrow" class="arrow" /></a>
      </div>
      <div class="rel__grid">{recs.map((p) => <ProductCard p={p} />)}</div>
    </section>
  )}

  <a class="cnext theme-dark" href={url(`/crops/${next.slug}/`)}>
    <img src={url(`/img/aea/crop-${next.slug}-wide.avif`)} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
    <div class="wrap cnext__inner">
      <span class="mono">Next program</span>
      <span class="cnext__name">{next.name} <Icon name="arrow" size={48} /></span>
    </div>
  </a>
</Base>

<style>
  .chero { position: relative; min-height: 88svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; padding-bottom: clamp(40px, 6vw, 80px); }
  .chero__bg { position: absolute; inset: 0; z-index: -1; }
  .chero__bg img { width: 100%; height: 100%; object-fit: cover; animation: kb 18s var(--ease-in-out) infinite alternate; }
  @keyframes kb { to { transform: scale(1.08); } }
  .chero__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(13, 12, 9, 0.9), rgba(13, 12, 9, 0.2) 60%, rgba(13, 12, 9, 0.5)); }
  .chero__inner { padding-top: calc(var(--nav-h) + 60px); }
  .chero .crumbs { color: rgba(255, 255, 255, 0.6); }
  .chero h1 { color: #fff; }
  .chero__row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 48px; margin-top: 28px; flex-wrap: wrap; }
  .chero .lead { color: rgba(255, 255, 255, 0.8); max-width: 52ch; }
  .chero__subs { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chero__subs .chip { color: #fff; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35); backdrop-filter: blur(8px); }
  .cbody { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); }
  .cbody__lead h2 { margin-top: 20px; }
  .cbody__text { font-size: 1.05rem; align-self: end; }
  .cbody__hl { grid-column: 1 / -1; display: flex; gap: 24px; align-items: flex-start; padding: clamp(28px, 4vw, 56px); border-radius: var(--radius); background: var(--sun); }
  .cbody__hl :global(svg) { flex: none; }
  .cbody__hl p { font-size: clamp(1.4rem, 1rem + 1.5vw, 2.4rem); letter-spacing: -0.035em; line-height: 1.12; font-weight: 500; }
  .cfaq { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 96px); }
  .cfaq em { color: var(--sage); }
  .cstory__q { font-size: clamp(1.5rem, 1rem + 2vw, 3rem); letter-spacing: -0.035em; line-height: 1.15; margin-top: 28px; max-width: 30ch; font-weight: 450; }
  .rel__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; margin-bottom: 36px; flex-wrap: wrap; }
  .rel__head em { color: var(--sage); }
  .rel__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .cnext { position: relative; display: block; overflow: hidden; height: clamp(280px, 40vw, 520px); isolation: isolate; }
  .cnext img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.6s var(--ease); }
  .cnext::after { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(13, 12, 9, 0.55); transition: background-color 0.6s; }
  .cnext:hover::after { background: rgba(13, 12, 9, 0.35); }
  .cnext:hover img { transform: scale(1.05); }
  .cnext__inner { height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: clamp(32px, 5vw, 64px); color: #fff; }
  .cnext .mono { color: var(--sun); }
  .cnext__name { display: flex; align-items: center; gap: 24px; font-size: clamp(3rem, 1rem + 8vw, 9rem); letter-spacing: -0.06em; line-height: 0.9; font-weight: 500; margin-top: 12px; }
  .cnext__name :global(svg) { transition: transform 0.6s var(--ease); }
  .cnext:hover .cnext__name :global(svg) { transform: translateX(16px); }
  @media (max-width: 900px) { .cbody, .cfaq { grid-template-columns: 1fr; } .rel__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
