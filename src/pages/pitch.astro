---
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url, catalog, products } from '../lib/site';
import pitch from '../data/pitch.json';

/* ------------------------------------------------------------------
   Personalize here — anything left empty is simply not shown.
------------------------------------------------------------------ */
const DESIGNER = {
  name: '',      // e.g. 'Jane Doe'
  role: '',      // e.g. 'Independent product designer'
  email: '',     // e.g. 'hello@janedoe.com' → enables the “Start the conversation” button
  website: '',   // e.g. 'https://janedoe.com'
};

const h = pitch.home, pr = pitch.product;
const sec = (ms: number) => `${(ms / 1000).toFixed(1)}s`;
const ms = (v: number) => `${Math.round(v).toLocaleString('en-US')}ms`;
const mb = (b: number) => (b >= 1e6 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.round(b / 1024)} KB`);
const times = (a: number, b: number) => (b > 0 ? `${Math.round(a / b)}×` : '∞');

const headline = [
  { k: 'Performance score', old: String(h.old.perf), neu: String(h.new.perf), note: 'Lighthouse, homepage' },
  { k: 'Largest paint', old: sec(h.old.lcp), neu: sec(h.new.lcp), note: `${(h.old.lcp / h.new.lcp).toFixed(1)}× faster` },
  { k: 'Page weight', old: mb(h.old.bytes), neu: mb(h.new.bytes), note: `${times(h.old.bytes, h.new.bytes)} lighter` },
  { k: 'JavaScript', old: mb(h.old.js), neu: mb(h.new.js), note: `${times(h.old.js, h.new.js)} less code` },
];
const rows = [
  { k: 'Performance', unit: '/100', a: h.old.perf, b: h.new.perf, c: pr.old.perf, d: pr.new.perf, fmt: (v: number) => String(v), better: 'high' },
  { k: 'Accessibility', unit: '/100', a: h.old.a11y, b: h.new.a11y, c: pr.old.a11y, d: pr.new.a11y, fmt: (v: number) => String(v), better: 'high' },
  { k: 'Best practices', unit: '/100', a: h.old.bp, b: h.new.bp, c: pr.old.bp, d: pr.new.bp, fmt: (v: number) => String(v), better: 'high' },
  { k: 'First paint', unit: '', a: h.old.fcp, b: h.new.fcp, c: pr.old.fcp, d: pr.new.fcp, fmt: sec, better: 'low' },
  { k: 'Largest paint (LCP)', unit: '', a: h.old.lcp, b: h.new.lcp, c: pr.old.lcp, d: pr.new.lcp, fmt: sec, better: 'low' },
  { k: 'Visually complete', unit: '', a: h.old.si, b: h.new.si, c: pr.old.si, d: pr.new.si, fmt: sec, better: 'low' },
  { k: 'Main-thread blocking', unit: '', a: h.old.tbt, b: h.new.tbt, c: pr.old.tbt, d: pr.new.tbt, fmt: ms, better: 'low' },
  { k: 'Requests', unit: '', a: h.old.reqs, b: h.new.reqs, c: pr.old.reqs, d: pr.new.reqs, fmt: (v: number) => String(v), better: 'low' },
  { k: 'JavaScript shipped', unit: '', a: h.old.js, b: h.new.js, c: pr.old.js, d: pr.new.js, fmt: mb, better: 'low' },
];
const raceMax = Math.max(h.old.si, h.old.lcp);
const race = [
  { label: 'Today', lcp: h.old.lcp, si: h.old.si },
  { label: 'Concept', lcp: h.new.lcp, si: h.new.si },
];

const demoUrl = new URL(url('/'), Astro.site).toString();
const qr = await QRCode.toString(demoUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#0d0c09', light: '#00000000' } });

const sample = products.find((p) => p.slug === 'biocoat-gold')!;
const samplePayload = JSON.stringify({ id: sample.sizes[1].id, pid: sample.id, slug: sample.slug, name: sample.name, size: sample.sizes[1].label, price: sample.sizes[1].price, img: sample.image, qty: 1 });

const principles = [
  { icon: 'sprout', t: 'Story before catalog', d: 'The homepage leads with why AEA exists — a scroll journey from canopy to root zone that makes soil biology visceral before anyone sees a jug.' },
  { icon: 'flask', t: 'Science you can touch', d: 'The Plant Health Pyramid, mineral tiles and a sample sap report turn AEA’s intellectual property into interactive, memorable moments.' },
  { icon: 'bag', t: 'Commerce without friction', d: 'Live prices per size, state-aware catalog, slide-out cart and a free-freight meter — buying takes seconds, not page loads.' },
  { icon: 'sun', t: 'Speed is a feature', d: 'Static pages, zero render-blocking resources, video that waits its turn. Growers on rural connections get the same experience.' },
  { icon: 'shield', t: 'Accessible by default', d: 'Semantic structure, keyboard paths, reduced-motion support and contrast-checked color — 97–100 on Lighthouse accessibility.' },
  { icon: 'chart', t: 'Low cost to run', d: 'Static hosting on a global CDN, a one-command catalog sync from WooCommerce, and no plugin stack to patch.' },
];

const tour = [
  { href: '/#dig', t: 'The soil descent', d: 'Scroll from the canopy into the roots', img: '/media/roots-800.avif', tag: 'Homepage' },
  { href: '/science/#pyramid', t: 'Plant Health Pyramid', d: 'Four levels, interactive', img: '/media/leaf-960.avif', tag: 'Science' },
  { href: '/shop/', t: 'State-aware shop', d: 'Pick California — watch the catalog adapt', img: '/media/ground-1344.avif', tag: 'Shop' },
  { href: '/shop/biocoat-gold/', t: 'Product experience', d: 'Sizes, live pricing, fly-to-cart', img: '/img/aea/crop-grains-and-legumes-480.avif', tag: 'Product' },
];
---
<Base title="Redesign proposal" description="A redesign proposal for Advancing Eco Agriculture: a working concept with measured performance gains and a no-migration path to the existing WooCommerce store." navTone="light">
  <!-- ============ HERO ============ -->
  <section class="ph theme-dark">
    <div class="ph__bg" aria-hidden="true"><img src={url('/media/hero-1600.avif')} alt="" width="1600" height="900" fetchpriority="high" /></div>
    <div class="wrap ph__inner">
      <p class="eyebrow" data-reveal="fade">Redesign proposal · Prepared for Advancing Eco Agriculture</p>
      <h1 class="display-hero ph__title" data-split>A site as <em class="serif">alive</em> as your soil.</h1>
      <div class="ph__row">
        <p class="lead" data-reveal style="--d:400">This is a working concept, not a mockup: AEA’s real catalog and prices, real content, a complete shopping flow, and a verified path to your existing checkout. Measured side by side with today’s site.</p>
        <div class="ph__ctas" data-reveal style="--d:550">
          <a class="btn btn--sun" href={url('/')}>Open the live demo <Icon name="arrow-up-right" class="arrow" /></a>
          <a class="btn btn--glass" href="#compare">See before &amp; after</a>
        </div>
      </div>
      <dl class="ph__stats" data-reveal style="--d:700">
        {headline.map((s) => (
          <div>
            <dt>{s.k}</dt>
            <dd><s class="tnum">{s.old}</s><Icon name="arrow" size={16} /><b class="tnum">{s.neu}</b></dd>
            <span class="mono">{s.note}</span>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ BEFORE / AFTER ============ -->
  <section class="section wrap" id="compare">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Before &amp; after</p>
        <h2 class="h1" data-split>Drag to <em class="serif">compare.</em></h2>
      </div>
      <div class="ba-tabs" role="tablist" aria-label="Comparison">
        <button type="button" role="tab" aria-selected="true" data-ba-tab="home">Homepage</button>
        <button type="button" role="tab" aria-selected="false" data-ba-tab="pdp">Product page</button>
        <button type="button" role="tab" aria-selected="false" data-ba-tab="mobile">Mobile</button>
      </div>
    </div>

    {[
      { id: 'home', old: 'old-home', neu: 'new-home', w: 1600, hgt: 1000 },
      { id: 'pdp', old: 'old-pdp', neu: 'new-pdp', w: 1600, hgt: 1000 },
    ].map((c, i) => (
      <div class="ba" data-ba={c.id} hidden={i !== 0} style="--pos:50%">
        <img class="ba__img" src={url(`/pitch/${c.neu}.avif`)} srcset={`${url(`/pitch/${c.neu}-800.avif`)} 800w, ${url(`/pitch/${c.neu}.avif`)} 1600w`} sizes="(max-width: 900px) 100vw, 1600px" alt="Concept redesign" width={c.w} height={c.hgt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        <div class="ba__old" aria-hidden="true">
          <img class="ba__img" src={url(`/pitch/${c.old}.avif`)} srcset={`${url(`/pitch/${c.old}-800.avif`)} 800w, ${url(`/pitch/${c.old}.avif`)} 1600w`} sizes="(max-width: 900px) 100vw, 1600px" alt="" width={c.w} height={c.hgt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </div>
        <span class="ba__label ba__label--l mono">Today</span>
        <span class="ba__label ba__label--r mono">Concept</span>
        <span class="ba__handle" aria-hidden="true"><Icon name="arrow" size={16} /><Icon name="arrow" size={16} /></span>
        <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Reveal today’s site versus the concept" data-ba-range />
      </div>
    ))}

    <div class="ba-m" data-ba="mobile" hidden>
      <figure>
        <div class="phone"><img src={url('/pitch/old-m.avif')} alt="Today’s homepage on iPhone" width="600" height="1022" loading="lazy" decoding="async" /></div>
        <figcaption class="mono muted">Today</figcaption>
      </figure>
      <figure>
        <div class="phone phone--new"><img src={url('/pitch/new-m.avif')} alt="Concept homepage on iPhone" width="600" height="1022" loading="lazy" decoding="async" /></div>
        <figcaption class="mono">Concept</figcaption>
      </figure>
      <div class="ba-m__qr">
        <div class="qr" set:html={qr} role="img" aria-label="QR code to open the demo on your phone"></div>
        <p><b>Try it on your phone.</b><br /><span class="muted">Scan to open the live demo — the scroll story was designed thumb-first.</span></p>
      </div>
    </div>
  </section>

  <!-- ============ NUMBERS ============ -->
  <section class="section theme-dark">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Measured, not promised</p>
          <h2 class="h1" data-split>Speed growers can <em class="serif">feel.</em></h2>
        </div>
        <p class="lead">Many growers browse from the field on rural connections. Every second of load time is a second they wait for the content they need.</p>
      </div>

      <figure class="race" data-reveal aria-labelledby="race-title">
        <p class="race__title" id="race-title">Homepage on a mid-range phone · seconds until…</p>
        <div class="race__legend mono" aria-hidden="true">
          <span><i class="sw sw--lcp"></i>Main content visible (LCP)</span>
          <span><i class="sw sw--si"></i>Page visually complete</span>
        </div>
        <div class="race__rows">
          {race.map((r) => (
            <div class="race__row" style={`--lcp:${(r.lcp / raceMax) * 100}%;--si:${(r.si / raceMax) * 100}%`}>
              <span class="race__label">{r.label}</span>
              <div class="race__track">
                <span class="race__bar race__bar--si" title={`Visually complete: ${sec(r.si)}`}></span>
                <span class="race__bar race__bar--lcp" title={`Main content: ${sec(r.lcp)}`}></span>
              </div>
              <span class="race__val tnum"><b>{sec(r.lcp)}</b> · {sec(r.si)}</span>
            </div>
          ))}
        </div>
      </figure>

      <div class="mtable-wrap" data-reveal>
        <table class="mtable">
          <caption class="sr-only">Lighthouse comparison: today’s site versus the concept</caption>
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col" colspan="2">Homepage</th>
              <th scope="col" colspan="2">Product page</th>
            </tr>
            <tr class="mtable__sub">
              <th></th><th scope="col">Today</th><th scope="col">Concept</th><th scope="col">Today</th><th scope="col">Concept</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row">{r.k}</th>
                <td class="tnum old">{r.fmt(r.a)}{r.unit && <small>{r.unit}</small>}</td>
                <td class="tnum neu">{r.fmt(r.b)}{r.unit && <small>{r.unit}</small>}</td>
                <td class="tnum old">{r.fmt(r.c)}{r.unit && <small>{r.unit}</small>}</td>
                <td class="tnum neu">{r.fmt(r.d)}{r.unit && <small>{r.unit}</small>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mono muted footnote">{pitch.tool} · measured {pitch.measured} · today = advancingecoag.com, concept = production build of this site. Homepage weight includes the hero film.</p>
    </div>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <section class="section wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">What changed</p>
        <h2 class="h1" data-split>Six ideas behind the <em class="serif">redesign.</em></h2>
      </div>
    </div>
    <div class="pgrid">
      {principles.map((p, i) => (
        <article class="pcell" data-reveal style={`--d:${(i % 3) * 90}`}>
          <span class="pcell__ic"><Icon name={p.icon} size={22} /></span>
          <span class="mono muted">0{i + 1}</span>
          <h3 class="h3">{p.t}</h3>
          <p class="muted">{p.d}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ INTEGRATION ============ -->
  <section class="section theme-bone">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Plugs into what you already run</p>
          <h2 class="h1" data-split>No store <em class="serif">migration.</em></h2>
        </div>
        <p class="lead">The cart lives in the browser. At checkout it hands off to AEA’s existing WooCommerce store using its built-in shareable checkout links — so orders, payments, taxes, freight rules and reporting stay exactly where they are today.</p>
      </div>
      <ol class="flow" aria-label="How checkout connects">
        <li class="flow__node" data-reveal><span class="flow__ic"><Icon name="sun" size={22} /></span><b>New site</b><span class="muted">Static pages on a global CDN</span></li>
        <li class="flow__node" data-reveal style="--d:120"><span class="flow__ic"><Icon name="bag" size={22} /></span><b>Cart</b><span class="muted">Sizes, quantities, state rules — instant, in the browser</span></li>
        <li class="flow__node" data-reveal style="--d:240"><span class="flow__ic"><Icon name="arrow-up-right" size={22} /></span><b>Checkout link</b><span class="muted">One URL carries the whole cart</span></li>
        <li class="flow__node flow__node--dark" data-reveal style="--d:360"><span class="flow__ic"><Icon name="lock" size={22} /></span><b>Your WooCommerce</b><span>Payments · tax · freight · orders · ERP — unchanged</span></li>
      </ol>
      <div class="code" data-reveal>
        <span class="mono muted">Example handoff — verified against the live store</span>
        <code>advancingecoag.com/checkout-link/?products=<mark>691:2</mark>,<mark>939:1</mark>,<mark>54407:1</mark></code>
        <span class="muted">Holo-K 1 gal × 2 · Spectrum 1 acre · Pinion → lands on your checkout with a $149.24 cart, ready to pay.</span>
      </div>
      <p class="muted integ-note">The demo ships in “demo checkout” mode so no real orders are created. Switching to the live handoff is a one-line change. The catalog ({catalog.length} products, every size and price) re-syncs from WooCommerce with a single command.</p>
    </div>
  </section>

  <!-- ============ TOUR ============ -->
  <section class="section wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Take the tour</p>
        <h2 class="h1" data-split>Five minutes, <em class="serif">four</em> moments.</h2>
      </div>
      <button class="btn btn--sun" type="button" data-sample-checkout data-add={samplePayload}>Try checkout with a sample cart <Icon name="arrow" class="arrow" /></button>
    </div>
    <div class="tour">
      {tour.map((t, i) => (
        <a class="tcard" href={url(t.href)} data-reveal style={`--d:${i * 90}`}>
          <img src={url(t.img)} alt="" width="800" height="500" loading="lazy" decoding="async" />
          <div class="tcard__body">
            <span class="chip">{t.tag}</span>
            <h3 class="h3">{t.t}</h3>
            <p>{t.d}</p>
          </div>
          <span class="tcard__go"><Icon name="arrow-up-right" size={20} /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- ============ NEXT STEPS ============ -->
  <section class="section theme-moss">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">From concept to launch</p>
          <h2 class="h1" data-split>What happens <em class="serif">next.</em></h2>
        </div>
      </div>
      <ol class="nsteps">
        {[
          ['Walkthrough & feedback', 'A live session with your team: what resonates, what’s missing, what your growers and agronomists need most.'],
          ['Refine design & content', 'Brand alignment, copy review with your agronomy team, and the remaining sections — blog, podcast, events, grower stories.'],
          ['Connect live systems', 'Switch on the WooCommerce handoff, route forms to your CRM, add analytics and the state-availability rules you already maintain.'],
          ['Launch & measure', 'Ship on your domain, monitor real-user speed and conversion, and keep iterating from data.'],
        ].map(([t, d], i) => (
          <li data-reveal style={`--d:${i * 90}`}>
            <span class="nsteps__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t}</h3>
            <p class="muted">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="pcta">
    <div class="wrap">
      <h2 class="pcta__title" data-split>Let’s grow this <em class="serif">together.</em></h2>
      <div class="pcta__row">
        <div>
          {DESIGNER.name && <p class="pcta__by"><span class="mono">Prepared by</span><b>{DESIGNER.name}</b>{DESIGNER.role && <span>{DESIGNER.role}</span>}</p>}
          <p class="pcta__p">Everything you’ve seen is real, working code — ready to evolve into AEA’s next website.</p>
        </div>
        <div class="pcta__btns">
          {DESIGNER.email && <a class="btn" href={`mailto:${DESIGNER.email}?subject=AEA%20website%20redesign`} style="--b-hover:var(--paper)">Start the conversation <Icon name="arrow" class="arrow" /></a>}
          {DESIGNER.website && <a class="btn btn--ghost" href={DESIGNER.website} style="--line:rgba(13,12,9,.3)">See more work</a>}
          <a class:list={['btn', { 'btn--ghost': !!DESIGNER.email }]} href={url('/')} style={DESIGNER.email ? '--line:rgba(13,12,9,.3)' : '--b-hover:var(--paper)'}>Open the live demo <Icon name="arrow-up-right" class="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { Cart } from '../scripts/app';
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    // before/after tabs
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ba-tab]'));
    const panes = Array.from(document.querySelectorAll<HTMLElement>('[data-ba]'));
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      panes.forEach((p) => (p.hidden = p.dataset.ba !== t.dataset.baTab));
    }));
    // sliders
    document.querySelectorAll<HTMLInputElement>('[data-ba-range]').forEach((r) => {
      const host = r.closest<HTMLElement>('.ba')!;
      const set = () => host.style.setProperty('--pos', `${r.value}%`);
      r.addEventListener('input', set);
      set();
      // gentle hint animation the first time it scrolls into view
      const io = new IntersectionObserver((e) => {
        if (!e[0].isIntersecting || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        io.disconnect();
        const frames = [50, 32, 68, 50];
        let i = 0;
        const step = () => { if (i >= frames.length) return; r.value = String(frames[i++]); set(); setTimeout(step, 520); };
        setTimeout(step, 400);
      }, { threshold: 0.5 });
      io.observe(host);
    });
    // sample cart → checkout
    document.querySelector<HTMLButtonElement>('[data-sample-checkout]')?.addEventListener('click', () => {
      setTimeout(() => { if (Cart.count() > 0) location.href = `${base}/checkout/`; }, 650);
    });
  </script>
</Base>

<style>
  /* hero */
  .ph { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; padding-bottom: clamp(32px, 5vw, 64px); }
  .ph__bg { position: absolute; inset: 0; z-index: -1; }
  .ph__bg img { width: 100%; height: 100%; object-fit: cover; }
  .ph__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(13, 12, 9, 0.95) 10%, rgba(13, 12, 9, 0.55) 55%, rgba(13, 12, 9, 0.35)); }
  .ph__inner { padding-top: calc(var(--nav-h) + 72px); }
  .ph .eyebrow { color: rgba(255, 255, 255, 0.75); }
  .ph__title { color: #fff; margin-top: 22px; max-width: 12ch; }
  .ph__title em { color: var(--sun); }
  .ph__row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 48px; margin-top: 32px; flex-wrap: wrap; }
  .ph .lead { color: rgba(255, 255, 255, 0.78); max-width: 52ch; }
  .ph__ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .ph__stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: clamp(40px, 6vw, 72px); border-top: 1px solid rgba(255, 255, 255, 0.16); padding-top: 22px; }
  .ph__stats dt { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  .ph__stats dd { display: flex; align-items: center; gap: 10px; margin-top: 8px; color: #fff; }
  .ph__stats dd s { font-size: 1.1rem; color: rgba(255, 255, 255, 0.45); text-decoration-thickness: 1px; }
  .ph__stats dd :global(svg) { color: rgba(255, 255, 255, 0.45); flex: none; }
  .ph__stats dd b { font-size: clamp(1.6rem, 1rem + 1.6vw, 2.6rem); font-weight: 500; letter-spacing: -0.04em; color: var(--sun); }
  .ph__stats .mono { color: rgba(255, 255, 255, 0.55); font-size: 0.65rem; }
  @media (max-width: 860px) { .ph__stats { grid-template-columns: repeat(2, 1fr); row-gap: 22px; } }

  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px 48px; flex-wrap: wrap; margin-bottom: clamp(36px, 5vw, 64px); }
  .sec-head h2 { margin-top: 18px; }
  .sec-head h2 em { color: var(--sage); }
  :global(.theme-dark) .sec-head h2 em, :global(.theme-moss) .sec-head h2 em { color: var(--sun); }

  /* before / after */
  .ba-tabs { display: inline-flex; padding: 4px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); }
