---
import Icon from './Icon.astro';
import { url } from '../lib/site';
---
<div class="drawer" data-drawer aria-hidden="true" inert>
  <div class="drawer__scrim" data-close-cart></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <div class="drawer__head">
      <h2 id="cart-title">Your cart <span class="muted tnum" data-cart-count-text style="font-size:1rem"></span></h2>
      <button class="icon-btn" type="button" data-close-cart aria-label="Close cart"><Icon name="close" /></button>
    </div>
    <div class="drawer__body" data-cart-items>
      <div class="drawer__empty">
        <Icon name="sprout" />
        <p>Your cart is empty — let’s grow something.</p>
        <a class="btn btn--sm" href={url('/shop/')}>Browse products</a>
      </div>
    </div>
    <div class="drawer__foot" data-cart-foot hidden>
      <p class="mono muted" data-ship-text>Free freight on orders over $500</p>
      <div class="ship-meter"><i data-ship-meter style="width:0%"></i></div>
      <div class="drawer__row" style="margin-top:14px">
        <span class="muted">Subtotal</span>
        <span class="drawer__total" data-cart-total>$0.00</span>
      </div>
      <p class="muted" style="font-size:.8rem;margin-bottom:16px">Taxes and freight calculated at checkout.</p>
      <a class="btn btn--sun btn--block" href={url('/checkout/')} data-checkout>Checkout <Icon name="arrow" class="arrow" /></a>
    </div>
  </aside>
</div>
